{
  "name": "zugunfall",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "shadow-cljs compile app",
    "exec": "node target/app.js",
    "build:dry-run": "shadow-cljs compile dry-run",
    "dry-run": "node target/dry-run/main.js",
    "test:dry-run": "shadow-cljs compile dry-run-test && node target/dry-run-test/main.js",
    "fmt": "clojure -M:cljfmt-fix && clojure -M:nsorg-fix src",
    "lint": "clojure -M:lint"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.21"
  },
  "dependencies": {
    "node-fetch": "^3.3.0",
    "node-html-parser": "^6.1.4"
  },
  "type": "module"
}
